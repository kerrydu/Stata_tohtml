@@@pytohtml stmt 2
{"start": 35, "end": 35, "hide": false}
xmin, xmax = min(mpg), max(mpg)
@@@pytohtml stmt 2
{"start": 36, "end": 36, "hide": false}
ymin, ymax = min(price), max(price)
@@@pytohtml stmt 2
{"start": 37, "end": 37, "hide": false}
dots = []
@@@pytohtml stmt 5
{"start": 38, "end": 41, "hide": false}
for x, y in zip(mpg, price):
    cx = 60 + (x - xmin) / (xmax - xmin) * 520
    cy = 300 - (y - ymin) / (ymax - ymin) * 250
    dots.append(f'<circle cx="{cx:.1f}" cy="{cy:.1f}" r="4" fill="#1a7f37"/>')
@@@pytohtml stmt 7
{"start": 42, "end": 47, "hide": false}
svg = (
    '<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360">'
    '<rect width="100%" height="100%" fill="white"/>'
    + "".join(dots)
    + "</svg>"
)
@@@pytohtml stmt 2
{"start": 48, "end": 48, "hide": false}
Path("figures/price.svg").write_text(svg, encoding="utf-8")
