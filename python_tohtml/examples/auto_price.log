@@@pytohtml heading 1
{"level": 2, "text": "相关"}
@@@pytohtml stmt 2
{"start": 52, "end": 52, "hide": false}
mx = sum(mpg) / n
@@@pytohtml stmt 2
{"start": 53, "end": 53, "hide": false}
cov = sum((x - mx) * (y - mean_price) for x, y in zip(mpg, price))
@@@pytohtml stmt 2
{"start": 54, "end": 54, "hide": false}
vx = math.sqrt(sum((x - mx) ** 2 for x in mpg))
@@@pytohtml stmt 2
{"start": 55, "end": 55, "hide": false}
vy = math.sqrt(sum((y - mean_price) ** 2 for y in price))
@@@pytohtml stmt 2
{"start": 56, "end": 56, "hide": false}
corr = cov / (vx * vy)
@@@pytohtml stmt 2
{"start": 57, "end": 57, "hide": false}
print(f"corr = {corr:.2f}")
@@@pytohtml output 1
