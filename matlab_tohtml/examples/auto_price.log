@@@mltohtml meta 1
{"version":1,"script":"/workspace/matlab_tohtml/examples/auto_price.m","cwd":"/workspace/matlab_tohtml/examples"}
@@@mltohtml heading 1
{"level":1,"text":"价格与油耗"}
@@@mltohtml md 1
{"text":"这份报告汇总汽车价格和油耗。","line":2,"file":"/workspace/matlab_tohtml/examples/auto_price.m"}
@@@mltohtml stmt 2
{"start":6,"stop":6,"hide":false}
rng(1);
@@@mltohtml stmt 2
{"start":7,"stop":7,"hide":false}
mpg = 15 + 25 * rand(24, 1);
@@@mltohtml stmt 2
{"start":8,"stop":8,"hide":false}
weight = 1800 + 2200 * rand(24, 1);
@@@mltohtml stmt 2
{"start":9,"stop":9,"hide":false}
price = 8000 - 180 * mpg + 1.5 * weight + 400 * randn(24, 1);
@@@mltohtml heading 1
{"level":2,"text":"描述统计"}
@@@mltohtml stmt 2
{"start":12,"stop":12,"hide":false}
s = matlab_tohtml.summarize('results/summary.html', {'价格', price, '每加仑英里数', mpg, '车重', weight});
@@@mltohtml tab 1
{"src":"results/summary.html","title":"描述统计","zoom":"","width":"","height":"","cssfile":""}
@@@mltohtml md 1
{"text":"共 24 个观测，价格均值约为 7224。","line":14,"file":"/workspace/matlab_tohtml/examples/auto_price.m"}
@@@mltohtml heading 1
{"level":2,"text":"价格与油耗"}
@@@mltohtml stmt 2
{"start":17,"stop":17,"hide":false}
matlab_tohtml.scatter('figures/price.svg', price, mpg, 'xlabel', '每加仑英里数', 'ylabel', '价格', 'fit', true);
@@@mltohtml fig 1
{"src":"figures/price.svg","title":"价格与每加仑英里数","zoom":"","width":"","height":"","cssfile":""}
@@@mltohtml heading 1
{"level":2,"text":"回归"}
@@@mltohtml stmt 2
{"start":21,"stop":21,"hide":false}
m1 = matlab_tohtml.regress(price, {'每加仑英里数', mpg});
@@@mltohtml stmt 2
{"start":22,"stop":22,"hide":false}
m2 = matlab_tohtml.regress(price, {'每加仑英里数', mpg, '车重', weight});
@@@mltohtml stmt 2
{"start":23,"stop":23,"hide":false}
matlab_tohtml.etable('results/regression.html', {m1, m2}, 'titles', {'(1)', '(2)'}, 'note', '因变量为价格。');
@@@mltohtml tab 1
{"src":"results/regression.html","title":"价格回归","zoom":"","width":"","height":"","cssfile":""}
@@@mltohtml show 1
{"name":"sprintf('%.1f', m1.params.('每加仑英里数'))","value":"-177.2"}
@@@mltohtml md 1
{"text":"只控制油耗时，每加仑英里数的系数为 {ishere display sprintf('%.1f', m1.params.('每加仑英里数'))}。\n\n$$\nprice = \\beta_0 + \\beta_1 mpg + \\varepsilon\n$$","line":26,"file":"/workspace/matlab_tohtml/examples/auto_price.m"}
